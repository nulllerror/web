:root {
    --primary-color: #ffffff;
    --secondary-color: #007AFF;
    --accent-color: #5AC8FA;
    --bg-color: #f5f7fa;
    --text-main: #1d1d1f;
    --text-muted: #86868b;
    --glass-bg: rgba(255, 255, 255, 0.7);
    --glass-border: rgba(255, 255, 255, 0.3);
    --radius-lg: 32px;
    --radius-md: 20px;
    --radius-sm: 12px;
    --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

[data-theme="dark"] {
    --primary-color: #1c1c1e;
    --secondary-color: #0a84ff;
    --bg-color: #000000;
    --text-main: #f5f5f7;
    --text-muted: #a1a1a6;
    --glass-bg: rgba(28, 28, 30, 0.7);
    --glass-border: rgba(255, 255, 255, 0.1);
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

html {
    scroll-behavior: smooth;
}

body {
    background-color: var(--bg-color);
    color: var(--text-main);
    overflow-x: hidden;
    line-height: 1.6;
    transition: background-color 0.5s ease;
}

/* Background Blobs */
.background-blobs {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    filter: blur(80px);
    opacity: 0.6;
    pointer-events: none;
}

.blob {
    position: absolute;
    border-radius: 50%;
    animation: float 20s infinite alternate;
}

.blob-1 {
    width: 400px;
    height: 400px;
    background: var(--secondary-color);
    top: -100px;
    right: -100px;
}

.blob-2 {
    width: 300px;
    height: 300px;
    background: var(--accent-color);
    bottom: -50px;
    left: -50px;
    animation-delay: -5s;
}

.blob-3 {
    width: 250px;
    height: 250px;
    background: #ffcc00;
    top: 40%;
    left: 30%;
    animation-delay: -10s;
}

@keyframes float {
    from { transform: translate(0, 0) rotate(0deg); }
    to { transform: translate(100px, 50px) rotate(360deg); }
}

/* Glassmorphism Utility */
.glass-card {
    background: var(--glass-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.1);
    transition: var(--transition);
}

.glass-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 40px 0 rgba(31, 38, 135, 0.15);
}

/* Navigation */
.glass-nav {
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    width: 90%;
    max-width: 1000px;
    z-index: 1000;
    background: var(--glass-bg);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border: 1px solid var(--glass-border);
    border-radius: 50px;
    padding: 10px 25px;
    transition: var(--transition);
}

.nav-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-weight: 800;
    font-size: 1.2rem;
    color: var(--text-main);
}

.logo span {
    color: var(--secondary-color);
}

.nav-links {
    display: flex;
    list-style: none;
    gap: 20px;
}

.nav-links a {
    text-decoration: none;
    color: var(--text-main);
    font-weight: 500;
    font-size: 0.9rem;
    transition: var(--transition);
    opacity: 0.8;
}

.nav-links a:hover {
    opacity: 1;
    color: var(--secondary-color);
}

.glass-btn {
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: 50%;
    width: 35px;
    height: 35px;
    cursor: pointer;
    color: var(--text-main);
    transition: var(--transition);
}

.glass-btn:hover {
    background: var(--secondary-color);
    color: white;
}

/* Sections */
.section {
    padding: 100px 20px;
    max-width: 1100px;
    margin: 0 auto;
}

.section-title {
    text-align: center;
    font-size: 2.5rem;
    margin-bottom: 50px;
    font-weight: 800;
}

/* Hero Section */
.hero {
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
}

.hero-card {
    text-align: center;
    padding: 60px 40px;
    max-width: 700px;
    width: 100%;
}

.profile-img img {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    border: 4px solid var(--secondary-color);
    margin-bottom: 20px;
    object-fit: cover;
}

.hero h1 {
    font-size: 3.5rem;
    margin-bottom: 10px;
    font-weight: 800;
}

.text-blue {
    color: var(--secondary-color);
}

.subtitle {
    font-size: 1.2rem;
    color: var(--text-muted);
    margin-bottom: 30px;
}

.hero-btns {
    display: flex;
    gap: 15px;
    justify-content: center;
}

.btn-primary, .btn-secondary {
    padding: 12px 28px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 600;
    transition: var(--transition);
    cursor: pointer;
    border: none;
}

.btn-primary {
    background: var(--secondary-color);
    color: white;
}

.btn-primary:hover {
    background: #005bb5;
    transform: scale(1.05);
}

.btn-secondary {
    background: var(--glass-bg);
    color: var(--text-main);
    border: 1px solid var(--glass-border);
}

.btn-secondary:hover {
    background: rgba(255,255,255,0.9);
    transform: scale(1.05);
}

/* About Section */
.about-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
}

.about-card {
    padding: 40px;
    text-align: center;
}

.about-card h3 {
    margin: 15px 0;
    font-size: 1.5rem;
}

.about-card p {
    color: var(--text-muted);
}

/* Projects Section */
.projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 30px;
}

.project-card {
    overflow: hidden;
    display: flex;
    flex-direction: column;
}

.project-image {
    height: 200px;
    background: linear-gradient(45deg, var(--secondary-color), var(--accent-color));
    opacity: 0.8;
}

.project-info {
    padding: 30px;
}

.project-info h3 {
    font-size: 1.5rem;
    margin-bottom: 10px;
}

.project-info p {
    color: var(--text-muted);
    margin-bottom: 20px;
}

.project-tags {
    display: flex;
    gap: 10px;
    margin-bottom: 20px;
}

.project-tags span {
    background: var(--glass-bg);
    padding: 4px 12px;
    border-radius: 50px;
    font-size: 0.8rem;
    font-weight: 600;
    border: 1px solid var(--glass-border);
}

.project-link {
    text-decoration: none;
    color: var(--secondary-color);
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

/* Skills Section */
.skills-container {
    padding: 60px;
    text-align: center;
}

.skills-cloud {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 15px;
}

.skill-pill {
    padding: 10px 20px;
    background: var(--primary-color);
    border: 1px solid var(--glass-border);
    border-radius: 50px;
    font-weight: 600;
    cursor: default;
    transition: var(--transition);
    box-shadow: 0 4px 10px rgba(0,0,0,0.05);
}

.skill-pill:hover {
    background: var(--secondary-color);
    color: white;
    transform: scale(1.1) rotate(2deg);
}

/* Contact Section */
.contact-container {
    max-width: 600px;
    margin: 0 auto;
    padding: 40px;
}

#contact-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.form-group input, .form-group textarea {
    width: 100%;
    padding: 15px 20px;
    border-radius: var(--radius-md);
    border: 1px solid var(--glass-border);
    background: var(--glass-bg);
    color: var(--text-main);
    font-size: 1rem;
    outline: none;
    transition: var(--transition);
}

.form-group input:focus, .form-group textarea:focus {
    border-color: var(--secondary-color);
    box-shadow: 0 0 0 3px rgba(0, 122, 255, 0.2);
}

/* Footer */
footer {
    text-align: center;
    padding: 50px 20px;
    color: var(--text-muted);
}

.social-links {
    margin-top: 20px;
    display: flex;
    justify-content: center;
    gap: 20px;
}

.social-links a {
    color: var(--text-main);
    font-size: 1.5rem;
    transition: var(--transition);
}

.social-links a:hover {
    color: var(--secondary-color);
    transform: translateY(-3px);
}

/* Responsiveness */
@media (max-width: 768px) {
    .nav-links {
        display: none;
    }

    .hero h1 {
        font-size: 2.5rem;
    }

    .section-title {
        font-size: 2rem;
    }
}
