<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CS Student | Portfolio</title>
    <link rel="stylesheet" href="style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <div class="background-blobs">
        <div class="blob blob-1"></div>
        <div class="blob blob-2"></div>
        <div class="blob blob-3"></div>
    </div>

    <nav class="glass-nav">
        <div class="nav-content">
            <div class="logo">CS<span>Student</span></div>
            <ul class="nav-links">
                <li><a href="#home">Home</a></li>
                <li><a href="#about">About</a></li>
                <li><a href="#projects">Projects</a></li>
                <li><a href="#skills">Skills</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>
            <button id="theme-toggle" class="glass-btn"><i class="fas fa-moon"></i></button>
        </div>
    </nav>

    <main>
        <section id="home" class="hero">
            <div class="hero-card glass-card">
                <div class="profile-img">
                    <img src="https://via.placeholder.com/150" alt="Profile Picture">
                </div>
                <h1>Hi, I'm <span class="text-blue">Alex</span> 👋</h1>
                <p class="subtitle">Computer Science Student & Aspiring Software Engineer</p>
                <div class="hero-btns">
                    <a href="#projects" class="btn-primary">View Work</a>
                    <a href="#contact" class="btn-secondary">Let's Chat</a>
                </div>
            </div>
        </section>

        <section id="about" class="section">
            <h2 class="section-title">About Me</h2>
            <div class="about-grid">
                <div class="about-card glass-card">
                    <i class="fas fa-code fa-2x text-blue"></i>
                    <h3>The Coder</h3>
                    <p>Passionate about building scalable applications and exploring the depths of algorithms and data structures.</p>
                </div>
                <div class="about-card glass-card">
                    <i class="fas fa-lightbulb fa-2x text-blue"></i>
                    <h3>The Learner</h3>
                    <p>Constantly curious, currently diving deep into Distributed Systems and Machine Learning.</p>
                </div>
                <div class="about-card glass-card">
                    <i class="fas fa-palette fa-2x text-blue"></i>
                    <h3>The Designer</h3>
                    <p>I believe that functionality and beauty should go hand in hand. I love clean, intuitive UIs.</p>
                </div>
            </div>
        </section>

        <section id="projects" class="section">
            <h2 class="section-title">Featured Projects</h2>
            <div class="projects-grid">
                <div class="project-card glass-card">
                    <div class="project-image"></div>
                    <div class="project-info">
                        <h3>AI Path-Finder</h3>
                        <p>A visualizer for A* and Dijkstra's algorithms built with React.</p>
                        <div class="project-tags">
                            <span>React</span>
                            <span>TypeScript</span>
                        </div>
                        <a href="#" class="project-link">View Project <i class="fas fa-arrow-right"></i></a>
                    </div>
                </div>
                <div class="project-card glass-card">
                    <div class="project-image"></div>
                    <div class="project-info">
                        <h3>SecureChat</h3>
                        <p>End-to-end encrypted messaging app using Socket.io and Node.js.</p>
                        <div class="project-tags">
                            <span>Node.js</span>
                            <span>Socket.io</span>
                        </div>
                        <a href="#" class="project-link">View Project <i class="fas fa-arrow-right"></i></a>
                    </div>
                </div>
                <div class="project-card glass-card">
                    <div class="project-image"></div>
                    <div class="project-info">
                        <h3>OS Kernel Mini</h3>
                        <p>A small educational operating system kernel written in Rust.</p>
                        <div class="project-tags">
                            <span>Rust</span>
                            <span>x86</span>
                        </div>
                        <a href="#" class="project-link">View Project <i class="fas fa-arrow-right"></i></a>
                    </div>
                </div>
            </div>
        </section>

        <section id="skills" class="section">
            <h2 class="section-title">My Toolkit</h2>
            <div class="skills-container glass-card">
                <div class="skills-cloud" id="skills-cloud">
                    <!-- Skills will be injected by JS -->
                </div>
            </div>
        </section>

        <section id="contact" class="section">
            <h2 class="section-title">Get In Touch</h2>
            <div class="contact-container glass-card">
                <form id="contact-form">
                    <div class="form-group">
                        <input type="text" placeholder="Your Name" required>
                    </div>
                    <div class="form-group">
                        <input type="email" placeholder="Your Email" required>
                    </div>
                    <div class="form-group">
                        <textarea placeholder="Your Message" rows="5" required></textarea>
                    </div>
                    <button type="submit" class="btn-primary">Send Message</button>
                </form>
            </div>
        </section>
    </main>

    <footer>
        <p>&copy; 2026 Alex CS. Built with ❤️ and lots of coffee.</p>
        <div class="social-links">
            <a href="#"><i class="fab fa-github"></i></a>
            <a href="#"><i class="fab fa-linkedin"></i></a>
            <a href="#"><i class="fab fa-twitter"></i></a>
        </div>
    </footer>

    <script src="script.js"></script>
</body>
</html>
